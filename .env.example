# Приложение: порт сервера, префикс API и адреса сервера и веб-клиента
PORT=8080
API_GLOBAL_PREFIX=api
APP_BASE_URL=http://localhost:8080
APP_WEB_URL=http://localhost:3000

# Swagger: путь к документации API
SWAGGER_PATH=docs/swagger

# PostgreSQL: подключение к базе данных
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=id-api
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis: адрес подключения и таймауты операций
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000

# Ограничение частоты запросов: окно и максимальное число запросов
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Сессии SSO: секрет JWT и сроки действия access- и refresh-токенов
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL=2592000

# OAuth / OpenID Connect: код авторизации, токены доступа и подпись ID-токенов
AUTHORIZATION_CODE_TTL=600
OAUTH_ACCESS_TTL=900
OAUTH_REFRESH_TTL=2592000
OAUTH_AUDIENCE=id-api
ID_TOKEN_TTL=3600
ID_TOKEN_PRIVATE_KEY=

# Очистка истории токенов: срок хранения в днях
TOKEN_HISTORY_RETENTION_DAYS=30

# Вход через Google: учётные данные, callback и параметры попытки входа
# Чтобы отключить вход через Google, оставьте учётные данные незаполненными
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
EXTERNAL_LOGIN_TTL=600
EXTERNAL_LOGIN_HTTP_TIMEOUT=10000

# SMTP: подключение к почтовому серверу и отправитель писем
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me
SMTP_SECURE=false
MAIL_FROM=SSO <no-reply@example.com>

# Подтверждение почты: секрет подписи и срок действия токена
EMAIL_CONFIRM_SECRET=change-me-mail-secret
EMAIL_CONFIRM_TTL=86400
