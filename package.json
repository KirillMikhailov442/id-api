{
  "name": "id-api",
  "version": "0.0.1",
  "packageManager": "pnpm@12.3.4",
  "description": "Identity provider API with OAuth 2.0 / OpenID Connect support (users, roles, sessions, clients, scopes)",
  "author": "Kirill Mikhailov <mikhailovkirill342@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikh-space/id-api.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" eslint.config.mjs \"scripts/**/*.mjs\" --no-error-on-unmatched-pattern",
    "start": "nest build && tsc-alias -p tsconfig.build.json && node dist/main",
    "start:dev": "cross-env NODE_ENV=development concurrently \"nest start --watch\" \"tsc-alias --watch -p tsconfig.build.json\"",
    "start:debug": "cross-env NODE_ENV=development concurrently \"nest start --debug --watch\" \"tsc-alias --watch -p tsconfig.build.json\"",
    "start:prod": "mkdir -p logs && cross-env NODE_ENV=production NO_COLOR=1 node dist/main >> logs/app.log 2>&1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "migration:generate": "tsx node_modules/typeorm/cli.js migration:generate src/migrations/AutoMigration -p -d src/config/database.ts",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" eslint.config.mjs \"scripts/**/*.mjs\" --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.3.2",
    "handlebars": "^4.7.10",
    "node-device-detector": "2.2.7",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
